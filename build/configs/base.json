{
  "metadata": {
    "name": "jira-importer",
    "version": "1.3.0",
    "description": "Jira Importer Application"
  },
  "directories": {
    "dist": "dist",
    "temp": "build/temp",
    "source": "src",
    "resources": "resources"
  },
  "files": {
    "requirements": "requirements.lock",
    "license": "LICENSE",
    "readme": "README_APP.md"
  },
  "dependencies": {
    "required": [
      "rich",
      "openpyxl",
      "colorlog",
      "requests",
      "keyring",
      "colorama"
    ]
  },
  "build_options": {
    "clean_dist": true,
    "clean_temp": true,
    "check_dependencies": true,
    "install_requirements": true,
    "copy_documentation": true,
    "build_version_file": true,
    "copy_resources_to_dist": true,
    "create_zip": true,
    "artifact_include_patterns": [
      "jira-importer",
      "jira-importer.exe",
      "jira-importer.app",
      "jira-importer.app/**",
      "resources/**",
      "*_LICENSE.md",
      "*_README.md"
    ]
  },
  "output_control": {
    "verbose": true,
    "show_progress": true,
    "show_warnings": true,
    "show_debug_info": false
  }
}
